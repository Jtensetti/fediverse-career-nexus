{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nolto-federation",
  "main": "nolto-gateway.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "nolto.social/.well-known/*", "zone_name": "nolto.social" },
    { "pattern": "nolto.social/functions/v1/*", "zone_name": "nolto.social" },
    { "pattern": "nolto.social/nodeinfo/*", "zone_name": "nolto.social" },
    { "pattern": "nolto.social/api/v1/*", "zone_name": "nolto.social" },
    { "pattern": "nolto.social/api/v2/*", "zone_name": "nolto.social" },
    { "pattern": "nolto.social/oauth/token*", "zone_name": "nolto.social" },
    { "pattern": "nolto.social/oauth/revoke*", "zone_name": "nolto.social" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "vars": {
    "GATEWAY_MODE": "route",
    "FEDERATION_DOMAIN": "nolto.social",
    "SUPABASE_ORIGIN": "https://anknmcmqljejabxbeohv.supabase.co",
    "ATPROTO_DID": ""
  }
}
