{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nolto-federation",
  "main": "nolto-gateway.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "nolto.social", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "vars": {
    "GATEWAY_MODE": "split",
    "FEDERATION_DOMAIN": "nolto.social",
    "FRONTEND_ORIGIN": "https://www.nolto.social",
    "SUPABASE_ORIGIN": "https://anknmcmqljejabxbeohv.supabase.co",
    "ATPROTO_DID": ""
  }
}
